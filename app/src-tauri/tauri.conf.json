{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadorphin",
  "version": "1.0.0",
  "identifier": "dev.cadorphin.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cadorphin",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Cadorphin",
    "category": "Graphics and Design",
    "shortDescription": "Design 3D-printable parts by talking to your coding agent",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFOENDMEREQzA0ODA2RTkKUldUcEJrakEzY0NNYml0SklsR1dFUjZJUng1RDB4aEFWTy9VdUNuRlVYMVJGY1JaSVovZGh4RTMK",
      "endpoints": [
        "https://github.com/seemantadutta/Cadorphin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
